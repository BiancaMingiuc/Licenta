# Address of the FastAPI backend, inlined at build time by Expo.
#
# Laptop browser: http://127.0.0.1:8000 works, because the page and the
# backend run on the same machine.
#
# Physical phone via Expo Go: 127.0.0.1 is the PHONE, not the laptop. Use the
# laptop's LAN address, for example http://192.168.1.10:8000, and start the
# backend with --host 0.0.0.0 so it accepts connections from the network.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
